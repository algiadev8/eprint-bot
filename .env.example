# Discord Webhook configuration
# Set separate webhooks to post new papers and updates to different channels.
DISCORD_NEW_WEBHOOK_URL=https://discord.com/api/webhooks/new_papers_channel
DISCORD_UPDATE_WEBHOOK_URL=https://discord.com/api/webhooks/updates_channel

# Optional fallback for either webhook above when it is not set.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# LLM API configuration (OpenAI-compatible)
# Examples:
# - OpenAI: https://api.openai.com/v1 (Model: gpt-4o-mini, gpt-4o)
# - DeepSeek: https://api.deepseek.com/v1 (Model: deepseek-chat)
# - Gemini (via OpenAI compatibility): https://generativelanguage.googleapis.com/v1beta/openai (Model: gemini-1.5-flash)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Optional configuration
# Language in which to summarize the abstract (e.g. Japanese, English)
SUMMARY_LANGUAGE=Japanese
